+# Environment
+.env
+
+# Logs and databases
+*.log
+*.sqlite
+redis_data/
+
+# IDE and OS
+.idea/
+.vscode/
+.DS_Store
+
+# Temporary files
+*.tmp
+*.bak
+*.swp
