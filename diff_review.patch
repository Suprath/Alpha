+++ b/shared/cpp/include/alpha/models/MarketModels.hpp
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <alpha/time/Timestamp.hpp>
+
+namespace alpha::models {
+
+/**
+ * @brief 5-level Market Depth level.
+ */
+struct MarketDepthLevel {
+    double price;
+    uint32_t quantity;
+    uint32_t orders;
+};
+
+/**
+ * @brief Options Greeks for a single contract.
+ */
+struct OptionGreeks {
+    double delta;
+    double gamma;
+    double theta;
+    double vega;
+    double iv;
+};
+
+/**
+ * @brief High-resolution Market Tick (L1 + L2).
+ * Fixed-size POD for zero-copy shared memory.
+ */
+struct Tick {
+    uint64_t timestamp_ns;      // Alpha Internal IST Precision
+    uint64_t exchange_time_ns;  // Exchange-provided timestamp
+    double last_price;
+    uint32_t last_quantity;
+    uint64_t total_volume;
+    double vwap;
+    
+    // Market Depth (L2) - 5 levels as per Upstox V3
+    MarketDepthLevel bids[5];
+    MarketDepthLevel asks[5];
+    
+    // Optional Greeks (0.0 if not applicable)
+    OptionGreeks greeks;
+};
+
+/**
+ * @brief Historical OHLCV Candle.
+ */
+struct Candle {
+    uint64_t timestamp_ns; // Start of period
+    double open;
+    double high;
+    double low;
+    double close;
+    uint64_t volume;
+    int32_t open_interest;
+
+    /**
+     * @brief Normalize candle to 4 synthetic ticks clustered at the end of the minute.
+     * @return Vector of 4 Ticks {Open, High, Low, Close}
+     */
+    inline std::vector<Tick> normalize_to_ticks() const {
+        std::vector<Tick> ticks;
+        ticks.reserve(4);
+        
+        // Per user request, all synthetic ticks are clustered at the end (HH:MM:59.999...)
+        uint64_t end_ts = timestamp_ns + 59999000000ULL; // Approximate end of 1m candle
+        
+        // Open, High, Low, Close
+        auto create_tick = [&](double p) {
+            Tick t {};
+            t.timestamp_ns = end_ts;
+            t.last_price = p;
+            return t;
+        };
+
+        ticks.push_back(create_tick(open));
+        ticks.push_back(create_tick(high));
+        ticks.push_back(create_tick(low));
+        ticks.push_back(create_tick(close));
+
+        return ticks;
+    }
+};
+
+} // namespace alpha::models
